{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash '{{KIT}}/hooks/security-bash.sh'", "timeout": 10},
          {"type": "command", "command": "python3 '{{KIT}}/foreman/factory_guard.py'", "timeout": 10}
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {"type": "command", "command": "bash '{{KIT}}/hooks/security-file-write.sh'", "timeout": 10},
          {"type": "command", "command": "python3 '{{KIT}}/foreman/factory_guard.py'", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "test -f '{{KIT}}/hooks/ask_me_stop.py' && python3 '{{KIT}}/hooks/ask_me_stop.py' || true", "timeout": 10}
        ]
      },
      {
        "hooks": [
          {"type": "command", "command": "test -f '{{KIT}}/hooks/codex_watch_stop.py' && python3 '{{KIT}}/hooks/codex_watch_stop.py' || true", "timeout": 10}
        ]
      }
    ]
  }
}
