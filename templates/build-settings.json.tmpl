{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash({{SAFE_PUSH}} *)",
      "Bash({{ASK_ME}} *)",
      "Bash(python3 {{ASK_ME}} *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "git *",
      "{{SAFE_PUSH}} *",
      "{{ASK_ME}} *",
      "python3 {{ASK_ME}} *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache/pip",
        "~/Library/Caches/pip",
        "~/.cache/uv",
        "~/Library/Caches/uv",
        "~/.cache/node-gyp"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.gnupg",
        "~/.netrc",
        "{{TOKEN_FILE}}",
        "{{ENV_FILE}}"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "{{BEEPER_HOST}}"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash '{{KIT}}/hooks/security-bash.sh'", "timeout": 10},
          {"type": "command", "command": "python3 '{{KIT}}/foreman/factory_guard.py'", "timeout": 10}
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "bash '{{KIT}}/hooks/security-file-write.sh'", "timeout": 10},
          {"type": "command", "command": "python3 '{{KIT}}/foreman/factory_guard.py'", "timeout": 10}
        ]
      }
    ]
  }
}
