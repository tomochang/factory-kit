{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash '{{KIT}}/hooks/security-bash.sh'", "timeout": 10},
          {"type": "command", "command": "python3 '{{KIT}}/foreman/factory_guard.py'", "timeout": 10}
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "bash '{{KIT}}/hooks/security-file-write.sh'", "timeout": 10},
          {"type": "command", "command": "python3 '{{KIT}}/foreman/factory_guard.py'", "timeout": 10}
        ]
      },
      {
        "matcher": "mcp__whatsapp__reply",
        "hooks": [
          {"type": "command", "command": "python3 '{{KIT}}/hooks/reply_guard.py'", "timeout": 60}
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python3 '{{KIT}}/hooks/run_budget.py'", "timeout": 5}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python3 '{{KIT}}/hooks/run_budget.py'", "timeout": 5}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python3 '{{KIT}}/hooks/run_budget.py'", "timeout": 5}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 '{{KIT}}/hooks/run_budget.py'", "timeout": 15}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 '{{KIT}}/hooks/reply_guard.py'", "timeout": 10},
          {"type": "command", "command": "python3 '{{KIT}}/hooks/run_budget.py'", "timeout": 5}
        ]
      }
    ]
  }
}
