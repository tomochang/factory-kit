# factory-kit settings for this Mac. Copy to factory.env (gitignored, never committed) and fill it in:
#   cp factory.env.example factory.env && chmod 600 factory.env
# Real environment variables win over this file. $HOME and ~ are expanded.

# How the agents address you in messages and instructions.
OWNER_NAME="Your Name"

# Beeper chat ID of your own WhatsApp "message yourself" chat (starts with "!", ends with ":beeper.local").
# Find it in Beeper Desktop (chat > ... > copy chat ID) or with the Beeper Desktop API.
# ask-me and the channel refuse any chat that is not your own 1:1 chat.
CHAT_ID=""

# File holding the Beeper Desktop API token (Beeper Desktop > Settings > Developers). Keep it chmod 600.
TOKEN_FILE="$HOME/.config/factory-kit/beeper-token"

# Beeper Desktop API on this Mac (only 127.0.0.1 is accepted).
BEEPER_BASE="http://127.0.0.1:23373"

# Where the foreman runs and each task's repo lives.
WORK_DIR="$HOME/factory"

# Folders the factory must never change (git writes and file edits are blocked), separated by ":".
# The kit's own folder is always protected. Example: "$HOME/notes:$HOME/work/main-repo"
PROTECTED_DIRS=""

# Time zone for the watchdog's messages (an IANA name such as Asia/Tokyo or Europe/Berlin).
TZ="UTC"

# 1 = Codex builds (foreman/codex-run.sh) run with `--sandbox workspace-write`: commands can write only the
# worktree. With it on, git commit and ask-me don't work inside the build (the worktree's git directory is
# read-only and the network is off), so the foreman commits after Codex finishes. Off (0) by default.
CODEX_SANDBOX="0"

# The watchdog also watches Codex runs (codex exec, the VS Code/Desktop client, the TUI) from the rollout files
# Codex writes, and tells you when one finishes, stops without finishing, is interrupted, or sits idle this many
# minutes after finishing. A run still working (its codex process alive) is never reported, however quiet.
CODEX_IDLE_MIN="10"
# Where Codex keeps its rollouts (<CODEX_HOME>/sessions).
CODEX_SESSIONS="$HOME/.codex/sessions"

# State of open ask-me questions, the channel heartbeat and the Codex watch.
ASK_ME_STATE="$HOME/.factory-kit/ask-me"

# WhatsApp reply guard (hooks/reply_guard.py): the foreman's replies are refused, with a rewrite hint, when they are
# longer than these limits, when their first line does not start "You:", "Nothing needed" or "Got it", when they hold
# a local file path outside a last "File:" line, when they claim done/green for a PR whose checks are not all green,
# or when they come as a burst (more than REPLY_BURST_MAX replies within REPLY_BURST_SECONDS, no new message from you).
REPLY_MAX_CHARS="700"
REPLY_MAX_LINES="10"
REPLY_BURST_MAX="2"
REPLY_BURST_SECONDS="120"
# Seconds the guard waits for `gh pr checks`; on timeout the claim is refused.
REPLY_GH_TIMEOUT="20"
# GitHub owner for "<repo> PR #<n>" in replies (full PR URLs and owner/repo#n work without it).
REPLY_GH_OWNER=""

# eringi-price (T30): a daily エリンギ price report to your own chat through scripts/ask-me.py --tell.
# Raw files and logs stay outside the repo. The real environment wins over these values.
ERINGI_DATA_DIR="$HOME/.local/share/eringi-price"
# ask-me.py used to send (default: this kit's scripts/ask-me.py)
ERINGI_ASK_ME=""
ERINGI_ITEM="エリンギ"
ERINGI_ITEM_CODE="386300"
# daily send time (JST) for the LaunchAgent, and the latest time a report still counts for the KGI
ERINGI_SEND_TIME="17:00"
ERINGI_DEADLINE="17:30"
ERINGI_BACKFILL_FROM="2024-01"
# seconds between requests (at least 1)
ERINGI_PAUSE="2"
ERINGI_LAUNCHD_LABEL="com.factory.eringi-price"
