# factory-kit settings for this Mac. Copy to factory.env (gitignored, never committed) and fill it in:
#   cp factory.env.example factory.env && chmod 600 factory.env
# Real environment variables win over this file. $HOME and ~ are expanded.

# How the agents address you in messages and instructions.
OWNER_NAME="Your Name"

# Beeper chat ID of your own WhatsApp "message yourself" chat (starts with "!", ends with ":beeper.local").
# Find it in Beeper Desktop (chat > ... > copy chat ID) or with the Beeper Desktop API.
# ask-me and the channel refuse any chat that is not your own 1:1 chat.
CHAT_ID=""

# File holding the Beeper Desktop API token (Beeper Desktop > Settings > Developers). Keep it chmod 600.
TOKEN_FILE="$HOME/.config/factory-kit/beeper-token"

# Beeper Desktop API on this Mac (only 127.0.0.1 is accepted).
BEEPER_BASE="http://127.0.0.1:23373"

# Where the foreman runs and each task's repo lives.
WORK_DIR="$HOME/factory"

# Folders the factory must never change (git writes and file edits are blocked), separated by ":".
# The kit's own folder is always protected. Example: "$HOME/notes:$HOME/work/main-repo"
PROTECTED_DIRS=""

# Time zone for the watchdog's messages (an IANA name such as Asia/Tokyo or Europe/Berlin).
TZ="UTC"

# State of open ask-me questions and the channel heartbeat.
ASK_ME_STATE="$HOME/.factory-kit/ask-me"
